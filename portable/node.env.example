# litnode settings, read by start-node.cmd. Copy to node.env and edit.
# One binary, one config: the only difference between an operator node and a
# volunteer node is what you write here.

# Who you are on the mesh. Your on-chain operator is the wallet that bonded
# this node's key, not this string.
OPERATOR=desktop

# Roles: mesh (serve rulesets/deltas, gossip, signalling), host (run
# matches), witness (verify others' matches), settler (build the hour's tree
# and prepare the anchor). An operator node runs all four.
ROLES=mesh,host,witness,settler

# Where this node is reachable by peers. Leave PUBLIC_ADDR unset to advertise
# the LAN IPv4; set it to your public https origin behind a tunnel or reverse
# proxy. HOST=0.0.0.0 listens on every interface.
PORT=7801
HOST=0.0.0.0
#PUBLIC_ADDR=https://node.example.com

# Peers to seed from, comma-separated. Empty is a valid mesh (the first node).
SEEDS=

# Rulesets to advertise (comma-separated). Old builds are kept automatically.
RULESETS=./rulesets/agent-fighter.v1.js,./rulesets/pickle-brawl.v1.js

# Persistent state: identity.json, cached builds, ledgers, deltas.
DATA_DIR=./data/desktop
REGION=ap-southeast

# Public reachability without a router or a certificate: the node runs its
# own Cloudflare tunnel and advertises the public URL in its heartbeat, so
# peers and the cabinet follow it automatically.
#   TUNNEL=quick        no account; a new *.trycloudflare.com host every run
#   TUNNEL=named        stable host; once: cloudflared tunnel login,
#                       cloudflared tunnel create <name>,
#                       cloudflared tunnel route dns <name> <host>
#TUNNEL=quick
#TUNNEL_NAME=litnode-seed
#TUNNEL_HOST=node.example.com
# Home router, no tunnel: ask it over UPnP to forward PORT (and RELAY_PORT)
# and advertise the public IP — what a torrent client does. /health.upnp
# says whether it worked, and says CGNAT when the ISP shares its public IP
# (then only a tunnel can make this node reachable).
#UPNP=1
# Front a title's relay running on this machine (Agent Fighter: npm run
# server → :8477) and advertise it as wsAddr through a second tunnel.
#RELAY_PORT=8477
#RELAY_TUNNEL_NAME=af-relay
#RELAY_TUNNEL_HOST=match.example.com

# Operator with the Agent Fighter checkout on this machine: install-task.cmd
# also registers the relay (npm run server there, fronted by RELAY_PORT) and
# the ledger watcher (tools/af-watch.mjs) as tasks. Needs <AF_ROOT>\.env.
#AF_ROOT=E:\NPC\AGENT FIGHTER\agent-fighter

# Chain. Defaults come from contracts/deployed.testnet.json. OFFLINE=1 uses a
# local beacon and no stake reads (dev only).
#RPC=https://liteforge.rpc.caldera.xyz/http
#NODE_STAKE=0x11C984bE3ee572eb7280334501B57c82001F397F
#OFFLINE=1
