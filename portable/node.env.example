# litnode settings, read by start-node.cmd and `npm run host`. Copy to
# node.env and edit; docs/OPERATORS.md walks through every line that matters.
# One binary, one config: the only difference between an operator node and a
# volunteer node is what you write here.

# Your node's name on the mesh: lowercase letters, digits and dashes, unique
# to you (alice-laptop, guild-b-vps). Your on-chain operator is the WALLET
# that bonds this node's key, not this string.
OPERATOR=my-node

# Roles: mesh (serve rulesets/deltas, gossip, signalling), host (run
# matches), witness (verify others' matches), settler (build the hour's tree
# and prepare the anchor). An operator node runs all four.
ROLES=mesh,host,witness,settler

# Where this node is reachable by peers. Leave PUBLIC_ADDR unset to advertise
# the LAN IPv4 (or the tunnel's URL, below); set it to your own public https
# origin behind a reverse proxy. HOST=0.0.0.0 listens on every interface.
PORT=7801
HOST=0.0.0.0
#PUBLIC_ADDR=https://node.example.com

# Peers to seed from, comma-separated. Leave empty: a node with chain access
# finds the mesh through NodeDirectory on its own.
SEEDS=

# Rulesets to host (comma-separated). Old builds are kept automatically.
RULESETS=./rulesets/agent-fighter.v1.js,./rulesets/pickle-brawl.v1.js

# Persistent state: identity.json (this node's key), cached builds, ledgers,
# deltas. Default ./data/<OPERATOR>. Back it up; never delete it once bonded.
#DATA_DIR=./data/my-node

# Your region; placement prefers hosts in the players' region.
# e.g. ap-southeast, eu-west, us-east.
#REGION=ap-southeast

# Public reachability without a router or a certificate: the node runs its
# own Cloudflare tunnel and advertises the public URL in its heartbeat, so
# peers and the cabinet follow it automatically. Needs cloudflared on PATH
# (Windows: winget install Cloudflare.cloudflared).
#   TUNNEL=quick        no account; a new *.trycloudflare.com host every run
#   TUNNEL=named        stable host; once: cloudflared tunnel login,
#                       cloudflared tunnel create <name>,
#                       cloudflared tunnel route dns <name> <host>
#TUNNEL=quick
#TUNNEL_NAME=litnode-seed
#TUNNEL_HOST=node.example.com
# Home router, no tunnel: ask it over UPnP to forward PORT and advertise the
# public IP. /health.upnp says whether it worked, and says CGNAT when the ISP
# shares its public IP (then only a tunnel can make this node reachable).
#UPNP=1
# RO3Emu (Ragnarok Online 3) server on this machine, started with --tunnel-port 5480: the node fronts that port
# with its own free quick tunnel and advertises it to the mesh (node/ro3.js). Players run
# RO3Emu.exe join litnode, which asks THEIR node for the current link, so a new hostname is followed by itself.
#RO3_PORT=5480
#RO3_NAME=Prontera

# Host Agent Fighter matches on this node (docs/OPERATORS.md, step 6): for
# each match placed here the node runs the game's own match server, with no
# database and no publisher key. The server comes from the mesh as a bundle
# the publisher registered under the title; your node fetches it by hash and
# keeps it under data/. This is an opt-in: it is a real process on this
# machine. The gateway port is fronted by the relay tunnel (TUNNEL must be set).
#GAUNTLET_SERVERS=agent-fighter.v1
#GAUNTLET_GATEWAY_PORT=8478
# Each hosted match's process output: DATA_DIR\gauntlet-logs\<rulesetId>\<matchId>.log,
# 4 MB per file, the newest 100 per title. GAUNTLET_LOGS=0 keeps none.
#GAUNTLET_LOG_MAX_MB=4
#GAUNTLET_LOG_KEEP=100

# Publisher machines only: front a title's always-on relay on this machine
# (Agent Fighter: npm run server → :8477) and advertise it as wsAddr. With
# GAUNTLET_GATEWAY_PORT set as well, the gateway passes unknown rooms on to it.
# Agent Fighter's relay matches are casual and stay in its own database; only
# the gauntlet above sends its matches to the mesh.
#RELAY_PORT=8477
#RELAY_TUNNEL_NAME=af-relay
#RELAY_TUNNEL_HOST=match.example.com
# Publisher machines only: install-task.cmd also registers that relay as a
# task (npm run server in AF_ROOT, which needs its .env). The relay takes only
# AF_ROOT and RELAY_PORT from this file; its own settings go in AF_ROOT\.env.
#AF_ROOT=C:\path\to\agent-fighter

# Chain. Defaults come from contracts/deployed.testnet.json. OFFLINE=1 uses a
# local beacon and no stake reads (dev only).
#RPC=https://liteforge.rpc.caldera.xyz/http
# Backup endpoints for the same chain, comma-separated. While RPC fails (timeouts,
# 5xx pages, rate limits) the node uses these, and returns to RPC once it answers.
#RPC_FALLBACK=https://another-liteforge-endpoint.example/http
#OFFLINE=1

# Universal login (docs/UNIVERSAL-LOGIN.md). On whenever PlayerProfile is set and the
# chain is reachable: AIR Kit session tokens become a litVM proxy wallet + profile,
# whose key is kept in this node's DATA_DIR. Pin tokens to your partner app
# (recommended); AIR=0 turns it off.
#AIR_PARTNER_ID=62e01755-138f-4e58-9cdc-fab71e037afd
#AIR_JWKS_URL=https://static.air3.com/.well-known/jwks.json,https://static.sandbox.air3.com/.well-known/jwks.json
#AIR=0
